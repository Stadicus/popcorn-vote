{
	"name": "popcorn-vote",
	"version": "1.4.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"sync": "svelte-kit sync",
		"check": "npm run sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"lint:secrets": "secretlint --maskSecrets --secretlintignore .gitignore \"**/*\"",
		"audit:prod": "npm audit --omit=dev --audit-level=high",
		"audit:all": "npm audit --audit-level=moderate",
		"deps:outdated": "npm outdated --depth=0",
		"verify": "npm run lint:secrets && npm run lint && npm run check && npm run test:coverage && npm run build && npm run audit:prod",
		"format": "prettier --write .",
		"test:e2e": "playwright test --project=chromium"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright-core": "^1.62.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"secretlint": "^13.0.7",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.2"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
